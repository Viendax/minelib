// Informations de l'exécutable (Propriétés → Détails sous Windows). Un exécutable qui
// dit qui il est et ce qu'il fait est moins souvent pris pour un virus par les antivirus.
#include <winver.h>

1 VERSIONINFO
FILEVERSION     0,@V@,0,0
PRODUCTVERSION  0,@V@,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName",      "Minelib"
      VALUE "FileDescription",  "Minelib - jeu de construction et FPS"
      VALUE "FileVersion",      "v@V@"
      VALUE "InternalName",     "minelib"
      VALUE "LegalCopyright",   "Minelib, licence AGPL-3.0"
      VALUE "OriginalFilename", "minelib.exe"
      VALUE "ProductName",      "Minelib"
      VALUE "ProductVersion",   "v@V@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
