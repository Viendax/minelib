// Informations de l'exécutable (Propriétés → Détails sous Windows). Un exécutable qui
// dit qui il est et ce qu'il fait est moins souvent pris pour un virus par les antivirus.
#include <winver.h>

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName",      "Minelib"
      VALUE "FileDescription",  "Minelib - lanceur (télécharge le jeu depuis GitHub)"
      VALUE "FileVersion",      "1"
      VALUE "InternalName",     "minelib-launcher"
      VALUE "LegalCopyright",   "Minelib, licence AGPL-3.0"
      VALUE "OriginalFilename", "minelib-launcher.exe"
      VALUE "ProductName",      "Minelib"
      VALUE "ProductVersion",   "1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
