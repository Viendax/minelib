# Serveur relais d'iroh de Minelib (ports 80 et 443 en TCP, 7842 en UDP).
[Unit]
Description=Serveur relais iroh (Minelib)
After=network-online.target
Wants=network-online.target

[Service]
User=minelib
WorkingDirectory=/var/lib/minelib
ExecStart=/opt/minelib/iroh-relay --config-path /etc/minelib/iroh-relay.toml
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
