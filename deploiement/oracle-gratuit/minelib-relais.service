# Relais officiel de Minelib (comptes, mondes, parties), sur la machine « relais ».
[Unit]
Description=Relais Minelib
After=network-online.target
Wants=network-online.target

[Service]
User=minelib
# Nos serveurs relais d'iroh, sans attendre une version du jeu qui les connaît
# (relais_iroh.txt) : remplacer les deux noms, ou supprimer la ligne.
Environment=MINELIB_RELAIS_IROH=https://<nom>1.duckdns.org,https://<nom>2.duckdns.org
WorkingDirectory=/var/lib/minelib
ExecStart=/opt/minelib/minelib-relay --dir /var/lib/minelib/relay_data --name "Minelib"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
